---
import { AUTHOR, SITE } from '../lib/posts';
import '../styles/global.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-600.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  published?: string;
}
const {
  title,
  description = 'Writing about software development, algorithms, C#, Excel, and occasional random thoughts.',
  article = false,
  published,
} = Astro.props;
const fullTitle = title ? `${title} · ${AUTHOR}` : AUTHOR;
const canonical = new URL(Astro.url.pathname, SITE).href;
const isAbout = Astro.url.pathname === '/about/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title={`${AUTHOR} · Feed`} href="/atom.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${AUTHOR}, home`}>
          <svg class="site-sprout" viewBox="0 0 24 24" shape-rendering="crispEdges" aria-hidden="true"><path fill="#6d8550" d="M11 10h3v12h-3zM3 3h7v3h3v7H6v-3H3zM17 6h5v7h-3v3h-5V9h3z"/><path fill="#a2b27d" d="M5 5h4v3H5zM17 8h3v3h-3z"/></svg>
          <span>{AUTHOR}<small>Software developer</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Writing</a>
          <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
          <a href="/atom.xml">RSS <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main">
        <div class="window-bar" aria-hidden="true"><span><span class="status-pixel"></span> bezensek.com / notebook</span><span class="window-marks">─ □ ×</span></div>
        <div class="window-content"><slot /></div>
      </main>
      <footer class="site-footer">
        <span><span class="status-pixel" aria-hidden="true"></span> © {new Date().getUTCFullYear()} {AUTHOR}</span>
        <nav aria-label="Footer navigation">
          <a href="/blog/archives/">Archives</a>
          <a href="/blog/categories/">Categories</a>
          <a href="https://github.com/MitjaBezensek">GitHub ↗</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
