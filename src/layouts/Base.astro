---
import { AUTHOR, SITE } from '../lib/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  published?: string;
}
const {
  title,
  description = 'Writing about software development, algorithms, C#, Excel, and occasional random thoughts.',
  article = false,
  published,
} = Astro.props;
const fullTitle = title ? `${title} · ${AUTHOR}` : AUTHOR;
const canonical = new URL(Astro.url.pathname, SITE).href;
const isAbout = Astro.url.pathname === '/about/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title={`${AUTHOR} · Feed`} href="/atom.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${AUTHOR}, home`}>
          <span class="monogram" aria-hidden="true">mb.</span>
          <span>{AUTHOR}<small>Software developer</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Writing</a>
          <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
          <a href="/atom.xml">RSS <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getUTCFullYear()} {AUTHOR}</span>
        <nav aria-label="Footer navigation">
          <a href="/blog/archives/">Archives</a>
          <a href="/blog/categories/">Categories</a>
          <a href="https://github.com/MitjaBezensek">GitHub ↗</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
