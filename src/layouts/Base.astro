---
import ButtonLink from '../components/ButtonLink.astro';
import { AUTHOR, SITE } from '../lib/posts';
import ThemeScript from '../components/ThemeScript.astro';
import DevDrawer from '../components/DevDrawer.astro';
import { Font } from 'astro:assets';
import siteIcon from '../assets/site-icon.svg?raw';
import favicon from '../assets/favicon.svg?url&no-inline';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  published?: string;
  noindex?: boolean;
  canonicalPath?: string;
}
const {
  title,
  description = 'Writing about software development, algorithms, C#, Excel, and occasional random thoughts.',
  article = false,
  published,
  noindex = false,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const fullTitle = title ? `${title} · ${AUTHOR}` : AUTHOR;
const canonical = new URL(canonicalPath, SITE).href;
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: published,
  mainEntityOfPage: canonical,
  url: canonical,
  author: { '@type': 'Person', name: AUTHOR, url: `${SITE}/about/` },
} : undefined;
const isWriting = article || Astro.url.pathname === '/' || /^\/page\/\d+\/$/.test(Astro.url.pathname) || Astro.url.pathname.startsWith('/blog/');
const isAbout = Astro.url.pathname === '/about/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="color-scheme" content="light dark" />
    <Font cssVariable="--font-mono" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal' }]} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <ThemeScript />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="alternate" type="application/atom+xml" title={`${AUTHOR} · Feed`} href="/atom.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${AUTHOR}, home`}>
          <Fragment set:html={siteIcon} />
          <span>{AUTHOR}<small>Chief gardener</small></span>
        </a>
        <div class="header-navigation">
          <nav class="main-navigation" aria-label="Main navigation">
            <ButtonLink href="/" aria-current={isWriting ? (Astro.url.pathname === '/' ? 'page' : 'location') : undefined}>Writing</ButtonLink>
            <ButtonLink href="/about/" aria-current={isAbout ? 'page' : undefined}>About</ButtonLink>
            <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to dark mode" hidden>
              <svg class="sun-icon" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM5 5h6v6H5z" /></svg>
              <svg class="moon-icon" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 1H6V3H4V5H2V11H4V13H6V15H12V13H14V9H12V11H8V9H6V5H8V3H10Z" /></svg>
            </button>
          </nav>
          <nav class="social-links" aria-label="Social links">
            <a href="https://twitter.com/mitjabezensek" rel="me">Twitter <span class="link-arrow" aria-hidden="true">↗</span></a>
            <a href="https://www.linkedin.com/in/mitjabezensek/" rel="me">LinkedIn <span class="link-arrow" aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </header>
      <main id="main">
        <div class="window-bar" aria-hidden="true"><span><span class="status-pixel"></span> bezensek.com / dev-notes</span><span class="window-marks">─ □ ×</span></div>
        <div class="window-content"><slot /></div>
      </main>
      <footer class="site-footer">
        <span><span class="status-pixel" aria-hidden="true"></span> © {new Date().getUTCFullYear()} {AUTHOR}</span>
        <nav aria-label="Footer navigation">
          <a href="/blog/archives/">Archives</a>
          <a href="/blog/categories/">Categories</a>
          <a href="https://github.com/MitjaBezensek">GitHub <span class="link-arrow" aria-hidden="true">↗</span></a>
        </nav>
      </footer>
    </div>
    {import.meta.env.DEV && <DevDrawer />}
  </body>
</html>
