---
import { formatDate, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li class="post-card">
      <time datetime={post.data.pubDate.slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
      <div>
        <h2><a class="post-title" href={post.data.url}>{post.data.title}</a></h2>
        <div class="post-summary">
          <p>{post.data.description}</p>
          <a class="read-link" href={post.data.url} aria-label={`Read ${post.data.title}`}>Read <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </li>
  ))}
</ol>
