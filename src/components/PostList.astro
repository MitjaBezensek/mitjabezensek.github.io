---
import { formatDate, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li class="post-card">
      <time datetime={post.data.pubDate.slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
      <div>
        <h2><a class="post-title" href={post.data.url}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </div>
    </li>
  ))}
</ol>
