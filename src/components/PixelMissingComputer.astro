---
interface Props { animated?: boolean }
const { animated = false } = Astro.props;
---
<svg class:list={["missing-computer", { animated }]} viewBox="0 0 144 88" fill="none" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  <path fill="var(--accent)" opacity="0.35" d="M26 80h111v2H26z" />
  <g transform="translate(0 7)">
  <path fill="var(--soft)" d="M30 13h73v50H30z" />
  <path fill="var(--accent)" d="M34 10h64v4H34zM30 14h4v43h-4zM98 14h4v43h-4zM34 57h64v4H34z" />
  <path fill="var(--computer-mid)" d="M34 14h64v43H34z" />
  <path fill="var(--paper)" d="M38 18h56v35H38z" />
  <path fill="var(--bar)" d="M38 18h56v6H38z" />
  <path fill="var(--computer-detail)" d="M42 20h2v2h-2zM46 20h2v2h-2zM50 20h2v2h-2z" />
  <g class="screen-error" fill="var(--accent)">
    <path d="M44 30h2v6h4v-6h2v14h-2v-6h-6zM57 30h8v2h-8zM55 32h2v10h-2zM65 32h2v10h-2zM57 42h8v2h-8zM70 30h2v6h4v-6h2v14h-2v-6h-6z" />
    <path fill="var(--secondary)" d="M82 42h5v2h-5z" />
    <path fill="var(--computer-detail)" d="M49 48h27v1H49zM79 48h5v1h-5z" />
  </g>
  <g class="screen-search" fill="var(--computer-detail)">
    <path d="M45 31h31v2H45zM45 36h21v2H45zM45 41h26v2H45z" />
    <path class="search-progress" fill="var(--accent)" d="M45 47h39v2H45z" />
  </g>
  <path fill="var(--accent)" d="M58 61h16v8H58zM50 69h32v4H50z" />
  <path fill="var(--computer-light)" d="M54 65h24v4H54z" />
  </g>
  <path fill="var(--accent)" d="M111 28h22v52h-22z" />
  <path fill="var(--computer-light)" d="M114 31h16v46h-16z" />
  <path fill="var(--paper)" d="M116 34h12v4h-12zM116 41h12v3h-12z" />
  <path fill="var(--accent)" d="M118 35h8v1h-8zM118 42h8v1h-8zM116 61h12v2h-12zM116 65h12v2h-12zM116 69h12v2h-12z" />
  <path fill="var(--accent)" d="M116 50h3v3h-3zM122 50h3v3h-3z" />
  <path class="power-light" fill="var(--accent)" d="M116 50h3v3h-3z" />
  <path class="drive-light" fill="var(--led)" d="M122 50h3v3h-3z" />
</svg>

<style>
  .missing-computer { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .screen-search { opacity: 0; }
  .animated .screen-search { animation: search 4.8s steps(1, end) both; }
  .animated .screen-error { animation: error 4.8s steps(1, end) both; }
  .animated .search-progress { transform-origin: 45px 47px; animation: progress 1.8s steps(13, end) both; }
  .animated .drive-light { animation: drive 0.6s steps(1, end) 3; }
  @keyframes search { 0% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes error { 0% { opacity: 0; } 40% { opacity: 1; transform: translateX(0); } 43% { transform: translateX(-2px); } 46% { transform: translateX(2px); } 49%, 82% { transform: translateX(0); } 86% { transform: translateX(-2px); } 90% { transform: translateX(2px); } 94%, 100% { transform: translateX(0); } }
  @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes drive { 0%, 100% { opacity: 1; } 50% { opacity: .2; } }
  @media (prefers-reduced-motion: reduce) { .missing-computer * { animation: none !important; } }
</style>
