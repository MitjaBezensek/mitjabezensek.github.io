<style>
  .pixel-computer {
    --compile-duration: 9s;
  }

  .terminal,
  .compiling {
    opacity: 0;
  }

  .terminal,
  .compiling,
  .success,
  .build-command,
  .cursor,
  .build-output,
  .build-progress,
  .power-light,
  .drive-light {
    animation-duration: var(--compile-duration);
    animation-iteration-count: infinite;
    animation-timing-function: steps(1, end);
  }

  .terminal { animation-name: terminal-phase; }
  .compiling { animation-name: compiling-phase; }
  .success { animation-name: success-phase; }
  .build-command { animation-name: type-command; animation-timing-function: steps(5, end); }
  .cursor { animation-name: blink-cursor; }
  .build-output { animation-name: scroll-output; animation-timing-function: steps(6, end); }
  .build-progress { animation-name: fill-progress; animation-timing-function: steps(15, end); transform-box: fill-box; transform-origin: left; }
  .power-light { animation-name: blink-power; }
  .drive-light { animation-name: blink-drive; }

  @keyframes terminal-phase {
    0% { opacity: 1; }
    28%, 100% { opacity: 0; }
  }

  @keyframes compiling-phase {
    0% { opacity: 0; }
    28% { opacity: 1; }
    62%, 100% { opacity: 0; }
  }

  @keyframes success-phase {
    0% { opacity: 0; }
    62%, 100% { opacity: 1; }
  }

  @keyframes type-command {
    0%, 5% { clip-path: inset(0 100% 0 0); }
    22%, 100% { clip-path: inset(0); }
  }

  @keyframes blink-cursor {
    0%, 10%, 20%, 100% { opacity: 1; }
    5%, 15%, 25% { opacity: 0; }
  }

  @keyframes scroll-output {
    0%, 28% { transform: translateY(0); }
    60%, 100% { transform: translateY(-24px); }
  }

  @keyframes fill-progress {
    0%, 28% { transform: scaleX(0); }
    60%, 100% { transform: scaleX(1); }
  }

  @keyframes blink-power {
    0%, 63%, 69%, 75%, 100% { opacity: 1; }
    66%, 72% { opacity: .3; }
  }

  @keyframes blink-drive {
    0%, 8%, 16%, 28%, 36%, 44%, 52%, 60%, 100% { opacity: .2; }
    4%, 12%, 20%, 32%, 40%, 48%, 56% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-computer * { animation: none; }
  }
</style>
