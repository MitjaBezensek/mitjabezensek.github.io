---
import { SITE } from '../lib/posts';
interface Props { url: string; identifierUrl?: string; }
const { url, identifierUrl = url } = Astro.props;
const identifier = `http://bezensek.com${identifierUrl}`;
const canonical = `${SITE}${url}`;
---
<section class="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">Discussion</h2>
  <p>Comments are hosted by Disqus. Load the discussion to read or join in.</p>
  <button id="load-comments" type="button">Load comments</button>
  <p id="comments-status" role="status"></p>
  <div id="disqus_thread"></div>
  <noscript><p>Enable JavaScript to load the comments.</p></noscript>
</section>
<script is:inline define:vars={{ identifier, canonical }}>
  document.getElementById('load-comments').addEventListener('click', function () {
    this.disabled = true;
    const status = document.getElementById('comments-status');
    status.textContent = 'Loading comments…';
    window.disqus_config = function () {
      this.page.identifier = identifier;
      this.page.url = canonical;
      this.callbacks.onReady = [function () {
        status.textContent = '';
        document.getElementById('load-comments').hidden = true;
      }];
    };
    const script = document.createElement('script');
    script.src = 'https://mitjabezensek.disqus.com/embed.js';
    script.onerror = () => {
      status.textContent = 'Comments could not load. Please try again.';
      document.getElementById('load-comments').disabled = false;
      script.remove();
    };
    document.body.appendChild(script);
  });
</script>
