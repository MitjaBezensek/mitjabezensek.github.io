---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('About page is missing');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <article class="article about">
    <header class="page-heading"><p class="eyebrow">A little background</p><h1>{page.data.title}.</h1><div class="article-meta">Originally written in 2014.</div></header>
    <div class="prose"><Content /></div>
  </article>
</Base>
