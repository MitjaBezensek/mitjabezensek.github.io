---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, PAGE_SIZE } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <section class="intro">
    <p class="eyebrow"><span aria-hidden="true">✳</span> The personal blog of Mitja Bezenšek</p>
    <h1>Writing, mostly<br />about software.</h1>
    <p class="intro-description">Notes on building things, understanding algorithms,<br class="desktop-break" /> and learning along the way.</p>
  </section>
  <section aria-labelledby="writing-heading">
    <div class="section-heading"><h2 id="writing-heading">Latest writing</h2><a href="/blog/archives/">All articles <span aria-hidden="true">↗</span></a></div>
    <PostList posts={posts.slice(0, PAGE_SIZE)} />
  </section>
  {posts.length > PAGE_SIZE && <nav class="pagination" aria-label="Pagination"><span>Page 1 of {Math.ceil(posts.length / PAGE_SIZE)}</span><a href="/page/2/">Older articles →</a></nav>}
</Base>
