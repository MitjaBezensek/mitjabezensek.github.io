---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import PixelGarden from '../components/PixelGarden.astro';
import { getPosts, PAGE_SIZE } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <section class="intro">
    <div class="intro-copy">
      <p class="eyebrow">A small corner of the internet</p>
      <h1>Code, notes &amp;<br />other curiosities.</h1>
      <p class="intro-description">I’m Mitja. I write about software, algorithms,<br class="desktop-break" /> and the things I learn while making things.</p>
      <a class="intro-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a>
    </div>
    <div class="garden-scene"><PixelGarden /><span>Growing one idea at a time.</span></div>
  </section>
  <section aria-labelledby="writing-heading">
    <div class="section-heading"><h2 id="writing-heading"><span class="status-pixel" aria-hidden="true"></span> Field notes</h2><a href="/blog/archives/">Browse the archive <span aria-hidden="true">↗</span></a></div>
    <PostList posts={posts.slice(0, PAGE_SIZE)} />
  </section>
  {posts.length > PAGE_SIZE && <nav class="pagination" aria-label="Pagination"><span>Page 1 of {Math.ceil(posts.length / PAGE_SIZE)}</span><a href="/page/2/">Older articles →</a></nav>}
</Base>
