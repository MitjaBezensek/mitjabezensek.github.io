---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import PixelComputer from '../components/PixelComputer.astro';
import { getPosts, PAGE_SIZE } from '../lib/posts';
const posts = await getPosts();
---
<Base>
  <section class="intro">
    <div class="intro-copy">
      <h1>Code, algorithms &amp; dev notes.</h1>
      <p class="intro-description">I’m Mitja. I write about code, solving problems, and building software.</p>
      <a class="intro-link" href="/about/">A little about me <span class="link-arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="computer-scene"><PixelComputer /><span>&gt; writing about software_</span></div>
  </section>
  <section aria-labelledby="writing-heading">
    <div class="section-heading"><h2 id="writing-heading"><span class="status-pixel" aria-hidden="true"></span> Latest posts</h2><a href="/blog/archives/">Browse the archive <span class="link-arrow" aria-hidden="true">→</span></a></div>
    <PostList posts={posts.slice(0, PAGE_SIZE)} />
  </section>
  {posts.length > PAGE_SIZE && <nav class="pagination" aria-label="Pagination"><span>Page 1 of {Math.ceil(posts.length / PAGE_SIZE)}</span><a href="/page/2/">Older articles <span class="link-arrow" aria-hidden="true">→</span></a></nav>}
</Base>
