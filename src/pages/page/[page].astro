---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, PAGE_SIZE, pageUrl, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { posts: posts.slice((index + 1) * PAGE_SIZE, (index + 2) * PAGE_SIZE), page: index + 2, total },
  }));
}
interface Props { posts: Post[]; page: number; total: number; }
const { posts, page, total } = Astro.props;
---
<Base title={`Writing · Page ${page}`}>
  <header class="page-heading"><p class="eyebrow">The archive</p><h1>Earlier writing.</h1><p>More notes from the notebook.</p></header>
  <PostList posts={posts} />
  <nav class="pagination" aria-label="Pagination">
    <a href={pageUrl(page - 1)}>← Newer articles</a>
    <span>Page {page} of {total}</span>
    {page < total && <a href={pageUrl(page + 1)}>Older articles →</a>}
  </nav>
</Base>
