---
import { getPosts, SITE, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts())
    .filter((post) => post.data.legacyUrl)
    .map((post) => ({
      params: { path: post.data.legacyUrl!.replace(/^\/blog\//, '').replace(/\/$/, '') },
      props: { post },
    }));
}
interface Props { post: Post; }
const { post } = Astro.props;
const destination = post.data.url;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination + window.location.search + window.location.hash);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={`${SITE}${destination}`} />
    <title>{post.data.title} · Moved</title>
  </head>
  <body>
    <noscript><p>This article has moved to <a href={destination}>{post.data.title}</a>.</p></noscript>
  </body>
</html>
